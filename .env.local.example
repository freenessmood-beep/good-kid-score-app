# GitHub-backed storage for Bunny Adventure.
#
# GITHUB_TOKEN: a fine-grained personal access token with
#   Repository access: only the data repo below
#   Permissions: Contents -> Read and write
# Create one at https://github.com/settings/personal-access-tokens/new
GITHUB_TOKEN=github_pat_xxxxxxxx

# owner/repo that holds data.json
GITHUB_DATA_REPO=your-username/good-kid-score-data

# Optional overrides (defaults shown)
# GITHUB_DATA_BRANCH=main
# GITHUB_DATA_PATH=data.json
